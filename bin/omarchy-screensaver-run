#!/bin/bash

# omarchy:summary=Run a command with an optional screensaver until it finishes
# omarchy:group=screensaver
# omarchy:name=run
# omarchy:args=<command> [args...]
# omarchy:examples=omarchy screensaver run npm run build | omarchy screensaver run make -j8

[[ ${1:-} == "--" ]] && shift
if (( $# == 0 )); then
  echo "Usage: omarchy-screensaver-run <command> [args...]" >&2
  exit 2
fi

# Off by default. Disabled and non-terminal invocations retain normal command I/O.
if omarchy-toggle-enabled screensaver-task-on && [[ -t 0 && -t 1 ]]; then
  exec python3 "$OMARCHY_PATH/default/omarchy/screensaver-task.py" "$@"
else
  exec "$@"
fi
